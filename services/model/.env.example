# Copy to .env for local runs. Real secrets live only in Dokploy, never in git.
# Shared with apps/api only. At least 32 characters: `openssl rand -base64 32`.
MODEL_HMAC_SECRET=
# development = labelled demo bundle (DATA DEMO); live = published ARIF-Net bundles only.
OUTLOOK_MODE=development
ARTIFACTS_DIR=/artifacts
HMAC_MAX_SKEW_SECONDS=60
# debug | info | warning | error
LOG_LEVEL=info
