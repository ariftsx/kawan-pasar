{
  "$description": "Spacing, radius, layout, elevation, motion, and z-index scales (docs 10 §5). Theme-independent.",
  "space": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "4": { "$value": "4px" },
    "8": { "$value": "8px" },
    "12": { "$value": "12px" },
    "16": { "$value": "16px" },
    "24": { "$value": "24px" },
    "32": { "$value": "32px" },
    "48": { "$value": "48px" },
    "64": { "$value": "64px" },
    "96": { "$value": "96px" }
  },
  "font-size": {
    "$type": "dimension",
    "$description": "Sized for older readers: body text is 18px and nothing is below 14px. rem, so the browser text-size setting still scales it.",
    "xs": { "$value": "0.875rem" },
    "sm": { "$value": "1rem" },
    "base": { "$value": "1.125rem" },
    "lg": { "$value": "1.25rem" },
    "xl": { "$value": "1.5rem" },
    "2xl": { "$value": "1.75rem" },
    "3xl": { "$value": "2.125rem" },
    "4xl": { "$value": "2.5rem" }
  },
  "line-height": {
    "$type": "number",
    "$description": "Unitless line height paired with each font-size step.",
    "xs": { "$value": 1.45 },
    "sm": { "$value": 1.5 },
    "base": { "$value": 1.55 },
    "lg": { "$value": 1.45 },
    "xl": { "$value": 1.3 },
    "2xl": { "$value": 1.25 },
    "3xl": { "$value": 1.15 },
    "4xl": { "$value": 1.1 }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "12px" },
    "xl": { "$value": "16px" },
    "full": { "$value": "999px" }
  },
  "layout": {
    "$type": "dimension",
    "page-margin": { "$value": "80px" },
    "page-margin-mobile": { "$value": "16px" },
    "max-content": { "$value": "1280px" }
  },
  "elevation": {
    "$description": "CSS box-shadow shorthand strings.",
    "1": { "$value": "0 1px 2px 0 rgb(26 23 18 / 0.06)" },
    "2": { "$value": "0 8px 24px -4px rgb(26 23 18 / 0.08)" }
  },
  "motion": {
    "$description": "CSS duration + easing shorthand strings; reduced motion sets durations to 0.",
    "fast": { "$value": "120ms ease-out" },
    "base": { "$value": "200ms cubic-bezier(0.2, 0, 0, 1)" },
    "slow": { "$value": "320ms cubic-bezier(0.2, 0, 0, 1)" }
  },
  "z": {
    "$type": "number",
    "base": { "$value": 0 },
    "sticky": { "$value": 100 },
    "overlay": { "$value": 200 },
    "sheet": { "$value": 300 },
    "toast": { "$value": 400 }
  }
}
