# Copy to .env for local runs. Real secrets live only in Dokploy, never in git.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Shared with the BFF (apps/web). At least 32 characters: `openssl rand -base64 32`.
SERVICE_TOKEN=
# Proxy subnets whose X-Forwarded-* headers are trusted (Traefik overlay network). Comma-separated.
TRUSTED_PROXY_CIDRS=10.0.0.0/8
DATABASE_URL=postgres://kp:CHANGE_ME@localhost:5432/kawan_pasar
# Two Valkey instances (P-05): an evicting cache and a never-evicting queue.
VALKEY_CACHE_URL=redis://:CHANGE_ME@localhost:6379
VALKEY_QUEUE_URL=redis://:CHANGE_ME@localhost:6380
# Internal model service and the HMAC secret it shares with this API (>= 32 characters).
MODEL_URL=http://localhost:8000
MODEL_HMAC_SECRET=
