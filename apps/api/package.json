{
  "name": "@kawan-pasar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kawan Pasar core API: NestJS modular monolith on Fastify, plus the BullMQ worker entrypoint.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "fastify": "5.12.5",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kawan-pasar/config": "workspace:*",
    "@nestjs/testing": "^12.1.3",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5"
  }
}
