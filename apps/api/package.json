{
  "name": "@kawan-pasar/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env --import tsx src/database/migrate.ts",
    "db:seed": "node --env-file=../../.env --import tsx src/database/seed/catalog.seed.ts",
    "db:test:reset": "node --env-file=../../.env --import tsx test/helpers/reset-cli.ts",
    "bundle:promote": "node --env-file=../../.env --import tsx src/bundles/cli.ts promote",
    "bundle:demo": "node --env-file=../../.env --import tsx src/bundles/cli.ts demo",
    "bundle:prices": "node --env-file=../../.env --import tsx src/bundles/cli.ts prices",
    "db:seed:articles": "node --env-file=../../.env --import tsx src/database/seed/articles.seed.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@kawan-pasar/catalog": "workspace:*",
    "@kawan-pasar/contracts": "workspace:*",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-fastify": "12.4.2",
    "@node-rs/argon2": "2.2.2",
    "bullmq": "6.7.6",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kawan-pasar/eslint-config": "workspace:*",
    "@kawan-pasar/tsconfig": "workspace:*",
    "@nestjs/testing": "12.4.2",
    "@swc/core": "1.16.22",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
