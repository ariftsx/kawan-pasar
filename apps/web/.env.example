# Copy to .env.local for development. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# demo | live — `demo` labels sample numbers as DATA DEMO (AC-05).
NEXT_PUBLIC_DATA_MODE=demo
# Server-only (never NEXT_PUBLIC_*): internal core API and the token it expects from the BFF.
API_INTERNAL_URL=http://localhost:4000
SERVICE_TOKEN=
