# Normalise every text file to LF, regardless of the contributor's OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary

# Lockfiles: collapse in diffs, never hand-merge.
pnpm-lock.yaml linguist-generated=true -diff
uv.lock        linguist-generated=true -diff
