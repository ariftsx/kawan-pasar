{
  "name": "kawan-pasar",
  "private": true,
  "type": "module",
  "description": "Kawan Pasar monorepo: web (Next.js), core API (NestJS), model service (FastAPI), and shared packages.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12.14 <13"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "prepare": "lefthook install",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@kawan-pasar/config": "workspace:*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "lefthook": "^2.2.0",
    "prettier": "^3.9.0",
    "turbo": "^2.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "prettier": "@kawan-pasar/config/prettier"
}
