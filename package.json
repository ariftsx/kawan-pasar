{
  "name": "kawan-pasar",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "node scripts/compose.mjs up -d --wait",
    "infra:down": "node scripts/compose.mjs down",
    "infra:check": "node scripts/infra-check.mjs",
    "model:export": "node scripts/model-export.mjs",
    "wa:balas": "node scripts/wa-reply.mjs",
    "env:init": "node scripts/gen-env.mjs",
    "audit:all": "node scripts/audit.mjs",
    "ingest:import": "node scripts/compose.mjs --profile jobs run --rm ingest import-csv --file /data/seed/prices_combined.csv"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
