# Do not fill by hand: run `node scripts/gen-env.mjs` to create .env with random
# secrets and the derived URLs. This file only documents the keys. .env is never committed.

# --- secrets (consumed by docker compose) ---
POSTGRES_SUPERUSER_PASSWORD=
KP_OWNER_PASSWORD=
APP_RW_PASSWORD=
INGEST_W_PASSWORD=
PGBOUNCER_AUTH_PASSWORD=
VALKEY_PASSWORD=
SERVICE_TOKEN=
WEB_REVALIDATE_TOKEN=
LOG_LEVEL=info

# --- host-side URLs (tooling and tests on this machine) ---
DATABASE_MIGRATION_URL=
DATABASE_URL=
INGEST_DATABASE_URL=
TEST_DATABASE_MIGRATION_URL=
TEST_DATABASE_URL=
TEST_INGEST_DATABASE_URL=
VALKEY_CACHE_URL=
VALKEY_QUEUE_URL=

# --- web (optional; default http://127.0.0.1:8080) ---
# Public origin used for canonical URLs, OpenGraph and the sitemap.
PUBLIC_SITE_URL=

